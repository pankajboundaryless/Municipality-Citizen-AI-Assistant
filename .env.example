# ── Gemini / Google AI ────────────────────────────────────────
GEMINI_API_KEY=

# Optional: override the default model
# MODEL=gemini-3.1-flash-live-preview

# Optional: voice for the AI assistant (Kore = firm/professional, Charon = informative)
# Available: Puck, Charon, Kore, Fenrir, Aoede
# GEMINI_VOICE=Kore

# Optional: server port (defaults to 8000)
# PORT=8000

# Optional: log file path — all errors and events are appended here
# LOG_FILE=log.txt

# ── UiPath Maestro Integration ────────────────────────────────
# Cloud organisation and tenant (from cloud.uipath.com URL)
UIPATH_ORGANIZATION=
UIPATH_TENANT=

# OAuth2 client credentials (create in UiPath Cloud > Admin > External Applications)
UIPATH_CLIENT_ID=
UIPATH_CLIENT_SECRET=

# Process key of the Maestro/Orchestrator process to trigger
UIPATH_PROCESS_KEY=

# Orchestrator folder name where the process lives (default: Default)
# UIPATH_FOLDER_NAME=Default

# ── OAuth Login (choose one provider) ────────────────────────
# Set OAUTH_PROVIDER to "microsoft" or "google"
OAUTH_PROVIDER=microsoft

# Required for all providers — use any long random string
SESSION_SECRET_KEY=change-me-to-a-long-random-secret

# Set to "true" in production (HTTPS only)
SESSION_HTTPS_ONLY=false

# ── Microsoft Entra ID (recommended for government portals) ───
# Register at: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# Redirect URI to register: http://localhost:8000/auth/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Use "common" to allow any Microsoft account, or paste your Tenant ID for org-only
MICROSOFT_TENANT_ID=common

# ── Google OAuth (alternative, simpler setup) ─────────────────
# Register at: https://console.cloud.google.com/apis/credentials
# Redirect URI to register: http://localhost:8000/auth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Twilio (optional — phone call integration) ────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_APP_HOST=
