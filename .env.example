# ── Gemini / Google AI ────────────────────────────────────────
GEMINI_API_KEY=

# Optional: override the default model
# MODEL=gemini-3.1-flash-live-preview

# Optional: voice for the AI assistant (Kore = firm/professional, Charon = informative)
# Available: Puck, Charon, Kore, Fenrir, Aoede
# GEMINI_VOICE=Kore

# Optional: server port (defaults to 8000)
# PORT=8000

# Optional: log file path — all errors and events are appended here
# LOG_FILE=log.txt

# ── UiPath Maestro Integration ────────────────────────────────
# Base URL for the UiPath platform (default: https://cloud.uipath.com)
UIPATH_URL=https://staging.uipath.com

# Organisation and tenant (from the UiPath platform URL)
UIPATH_ORGANIZATION=
UIPATH_TENANT=

# OAuth2 client credentials (create in UiPath Cloud > Admin > External Applications)
UIPATH_CLIENT_ID=
UIPATH_CLIENT_SECRET=

# Process key of the Maestro/Orchestrator process to trigger
UIPATH_PROCESS_KEY=

# Orchestrator folder name where the process and bucket live (default: Default)
# UIPATH_FOLDER_NAME=Default

# Storage bucket name for uploaded documents (default: Document_Repository)
# UIPATH_BUCKET_NAME=Document_Repository

# Document Understanding project GUID — enables automatic ID field extraction on upload
# UIPATH_DU_PROJECT_ID=

# ── OAuth Login ───────────────────────────────────────────────
SESSION_SECRET_KEY=change-me-to-a-long-random-secret
SESSION_HTTPS_ONLY=false

# ── Microsoft Entra ID ────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ── Google OAuth ──────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Twilio (optional — phone call integration) ────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_APP_HOST=
